new file mode 100644
index 0000000..e361cff
--- /dev/null
+++ b/src/onebot11/action/llbot/file/CancelFlashFile.ts
@@ -0,0 +1,22 @@
+import { BaseAction, Schema } from '@/onebot11/action/BaseAction'
+import { ActionName } from '@/onebot11/action/types'
+
+interface Payload {
+  file_set_id: string
+}
+
+interface Response {
+  cancelled: boolean
+}
+
+export class CancelFlashFile extends BaseAction<Payload, Response> {
+  actionName = ActionName.CancelFlashFile
+  payloadSchema = Schema.object({
+    file_set_id: Schema.string().required(),
+  })
+
+  async _handle(payload: Payload) {
+    await this.ctx.ntFileApi.stopFlashFileUpload(payload.file_set_id)
+    return { cancelled: true }
+  }
+}
