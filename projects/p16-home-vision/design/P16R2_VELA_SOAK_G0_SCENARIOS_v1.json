  "requirements": [
    {
      "id": "P16-17-1",
      "authority": "#17 rule 1",
      "invariant": "Only closed stopped-growing recordings autoqueued by NVR-local midnight"
    },
    {
      "id": "P16-17-2",
      "authority": "#17 rule 2",
      "invariant": "All eligible history and per-camera coverage; bounded read-only scans"
    },
    {
      "id": "P16-17-3",
      "authority": "#17 rule 3",
      "invariant": "Exactly one verified asset per logical recording"
    },
    {
      "id": "P16-17-4",
      "authority": "#17 rule 4",
      "invariant": "Crash-safe verify/download/lease/orphan recovery"
    },
    {
      "id": "P16-17-5",
      "authority": "#17 rule 5",
      "invariant": "Read-only bidirectional reconciliation and no destructive auto-repair"
    },
    {
      "id": "P16-17-6",
      "authority": "#17 rule 6",
      "invariant": "Archive success decoupled from optional intelligence"
    },
    {
      "id": "P16-11-C",
      "authority": "#11 Stage C",
      "invariant": "Media outputs + independently retryable transcript provenance"
    },
    {
      "id": "P16-11-D",
      "authority": "#11 Stage D",
      "invariant": "PTS-grounded frame reduce and representative benchmark evidence"
    },
    {
      "id": "P16-11-E",
      "authority": "#11 Stage E",
      "invariant": "Versioned immutable package and artifact bytes"
    },
    {
      "id": "P16-9-UI",
      "authority": "#9 UI",
      "invariant": "Six-page resource-driven React UI and local updates"
    },
    {
      "id": "P16-19-SAFE",
      "authority": "#19 safety",
      "invariant": "Strict Vela UAT-only data and egress scope, human-only RAW deletion"
    },
    {
      "id": "P16-19-OPER",
      "authority": "#19 operating",
      "invariant": "15 real days, bounded resources, durable complete per-day evidence"
    },
    {
      "id": "P16-19-LEARN",
      "authority": "#19 user latest direction",
      "invariant": "Bug fix->targeted+full regression->new permanent scenario; detect broken tests"
    }
  ],
