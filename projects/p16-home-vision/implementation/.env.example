# Non-secret deployment example only.
# Real credentials/endpoints are resolved through P15/P13 governance and are
# intentionally absent from this file.

HOME_VISION_ENVIRONMENT=production
HOME_VISION_UID=1000
HOME_VISION_GID=1000

# Direct backend publication stays loopback-only by default. Stable application
# access must go through P13. Do not set 0.0.0.0/:: merely for convenience; a
# genuine LAN-only exception must follow the repository restricted-ingress gate.
HOME_VISION_BIND_ADDRESS=127.0.0.1

# Must be a LOCAL filesystem suitable for SQLite (not NFS/SMB/CIFS).
HOME_VISION_STATE_DIR=/srv/home-vision/state

# Two independent archive volume mountpoints on the OMV Edge VM.
HOME_VISION_ARCHIVE_A=/srv/home-vision/archive-a
HOME_VISION_ARCHIVE_B=/srv/home-vision/archive-b

# Optional real NVR scanner. Inject these only through the approved runtime
# secret path; do not commit or paste secret values into this file.
# Provide HOME_VISION_NVR_BASE_URL, HOME_VISION_NVR_USERNAME,
# HOME_VISION_NVR_PASSWORD, HOME_VISION_NVR_ID, and optional
# HOME_VISION_NVR_TRACKS through the approved runtime secret path.

# Automatic queueing stays disabled by default. Enabling it requires a
# read-only-confirmed NVR business timezone and a separately measured
# per-camera retention horizon. This switch queues only sources that end
# before local midnight; it does not itself start downloads or workers.
HOME_VISION_ARCHIVE_AUTO_ENQUEUE=false
HOME_VISION_NVR_TIMEZONE_VERIFIED=false
# Initial discovery query window only; this is not a retention guarantee.
HOME_VISION_NVR_SCAN_INITIAL_DAYS=60
