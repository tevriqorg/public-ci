{
  "schema": "p2-soak-learning-rules-v1",
  "authority": "tevriqorg/P2-AIBOX#126",
  "state": "DESIGN_ONLY",
  "policy": {
    "promotion": "new tested regression via reviewed PR, no oracle rewrite",
    "proposal_cap_per_incident": 6,
    "proposal_cap_per_day": 12,
    "require_red_before_green": true,
    "require_negative_case": true,
    "require_independent_frozen_oracle": true,
    "auto_modify_original_oracle": false,
    "auto_weaken_assertions": false,
    "destructive_in_live_uat_allowed": false,
    "promotion_requires": [
      "original_evidence",
      "reproducer",
      "root_cause",
      "reviewed_fix_pr",
      "ci_pass",
      "targeted_retest",
      "broad_regression",
      "canary_live_smoke"
    ],
    "delivery": "issue126_checkpoint_and_sanitized_results"
  },
  "rules": [
    {
      "signature": "raw_corruption",
      "prioritized_case_ids": [
        "TR01",
        "TR04",
        "TR06",
        "RC02"
      ],
      "expansion_axes": [
        "content_hash",
        "size",
        "filesystem_sync",
        "recovery_after_kill"
      ],
      "required_mutation": "wrong_sha256",
      "only_in_isolated_clone_for_faults": true
    },
    {
      "signature": "identity_drift",
      "prioritized_case_ids": [
        "AR02",
        "AR04",
        "CO02",
        "CO03",
        "TR02"
      ],
      "expansion_axes": [
        "rename",
        "metadata_only",
        "changed_bytes",
        "repeated_event"
      ],
      "required_mutation": "duplicate_source_identity",
      "only_in_isolated_clone_for_faults": true
    },
    {
      "signature": "race_condition",
      "prioritized_case_ids": [
        "TR02",
        "TR03",
        "TR05",
        "CO05"
      ],
      "expansion_axes": [
        "two_writers",
        "lost_ack",
        "late_retry",
        "out_of_order"
      ],
      "required_mutation": "stale_commit_ack",
      "only_in_isolated_clone_for_faults": true
    },
    {
      "signature": "resource_permission",
      "prioritized_case_ids": [
        "AR03",
        "AR05",
        "SC01",
        "SC02"
      ],
      "expansion_axes": [
        "cross_tenant",
