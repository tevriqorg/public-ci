<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingLeft="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingRight="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium">

        <!-- P22: explicitly opt-in, on-device notification forwarding. -->
        <TextView
            style="@style/AppTheme.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p22_notifications_title" />

        <TextView
            style="@style/AppTheme.HelperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/p22_notifications_description" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/input_forward_notifications"
            style="@style/AppTheme.SwitchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/p22_notifications_enable" />

        <Button
            android:id="@+id/btn_notification_access"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/p22_open_notification_access" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTheme.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="@string/p22_notification_allowed_hint"
            app:helperText="@string/p22_notification_allowed_help">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_allowed_packages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword|textMultiLine"
                android:minLines="1"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTheme.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:hint="@string/p22_notification_blocked_hint"
            app:helperText="@string/p22_notification_blocked_help">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_blocked_packages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword|textMultiLine"
                android:minLines="1"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_select_allowed_apps"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/p22_pick_allowed_apps" />

        <Button
            android:id="@+id/btn_select_blocked_apps"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/p22_pick_blocked_apps" />

        <Button
            android:id="@+id/btn_notifications_save"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/p22_notification_save" />

        <TextView
            style="@style/AppTheme.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/p22_diagnostics_title" />

        <TextView
            android:id="@+id/p22_diagnostics"
            style="@style/AppTheme.HelperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/spacing_small"
            android:text="@string/p22_diagnostics_loading" />

        <Button
            android:id="@+id/btn_p22_shizuku_permission"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/p22_shizuku_request" />

        <Button
            android:id="@+id/btn_p22_app_settings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p22_open_app_settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="?android:attr/listDivider" />

        <TextView
            style="@style/AppTheme.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p22_device_status_title" />
        <TextView
            style="@style/AppTheme.HelperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p22_device_status_help" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/input_device_status"
            style="@style/AppTheme.SwitchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p22_device_status_enable" />
        <Button
            android:id="@+id/btn_device_status_save"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/p22_device_status_save" />
        <TextView
            style="@style/AppTheme.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_heartbeat_section" />

        <TextView
            style="@style/AppTheme.HelperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/heartbeat_info" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTheme.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_heartbeat_url"
            app:helperText="@string/input_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_heartbeat_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTheme.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:hint="@string/label_heartbeat_interval"
            app:helperText="@string/heartbeat_interval_recommendation">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_heartbeat_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/input_heartbeat_enabled"
            style="@style/AppTheme.SwitchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/label_heartbeat_enabled" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_heartbeat_test"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_test" />

            <Button
                android:id="@+id/btn_heartbeat_save"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginLeft="@dimen/spacing_small"
                android:text="@string/btn_save" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/backup_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider" />

            <TextView
                style="@style/AppTheme.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/label_backup_section" />

            <TextView
                style="@style/AppTheme.HelperText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/backup_info" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_import"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_import" />

                <Button
                    android:id="@+id/btn_export"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginLeft="@dimen/spacing_small"
                    android:text="@string/btn_export" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
